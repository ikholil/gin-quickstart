{
  "info": {
    "name": "Ecommerce API",
    "description": "Postman v2.1 collection for the Gin ecommerce API. Request URLs use the baseUrl collection variable directly. Run `make seed` and set admin credentials before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Local API origin"
    },
    {
      "key": "customerEmail",
      "value": "alex@example.test",
      "type": "string",
      "description": "Seeded local customer email"
    },
    {
      "key": "customerPassword",
      "value": "demo-alex-password",
      "type": "string",
      "description": "Seeded local customer password"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string",
      "description": "Set to ADMIN_EMAIL from .env"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string",
      "description": "Set to ADMIN_PASSWORD from .env; intentionally blank"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string",
      "description": "Saved by customer login"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "Saved by admin login"
    },
    {
      "key": "categoryId",
      "value": "seed-category-books",
      "type": "string",
      "description": "Overwritten by admin category creation"
    },
    {
      "key": "categoryName",
      "value": "",
      "type": "string",
      "description": "Generated uniquely by category creation"
    },
    {
      "key": "productId",
      "value": "seed-product-go-in-practice",
      "type": "string",
      "description": "Overwritten by admin product creation"
    },
    {
      "key": "secondProductId",
      "value": "seed-product-wireless-mouse",
      "type": "string",
      "description": "Overwritten by second product creation"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string",
      "description": "Saved by checkout"
    },
    {
      "key": "registeredEmail",
      "value": "",
      "type": "string",
      "description": "Generated by register request"
    },
    {
      "key": "registeredPassword",
      "value": "postman-demo-password",
      "type": "string",
      "description": "Temporary registration test password"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readyz"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });"
