      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register customer (optional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates a throwaway customer for testing. The pre-request script gives it a unique email each run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registeredPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"registeredEmail\", `postman-${Date.now()}@example.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "const payload = pm.response.json();",
                  "pm.test(\"Response contains data.id\", function () { pm.expect(payload.data && payload.data.id).to.be.ok; });",
                  "pm.collectionVariables.set(\"registeredCustomerId\", payload.data && payload.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login seeded customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Requires `make seed` to have created alex@example.test.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "const payload = pm.response.json();",
                  "pm.test(\"Response contains data.access_token\", function () { pm.expect(payload.data && payload.data.access_token).to.be.ok; });",
                  "pm.collectionVariables.set(\"customerToken\", payload.data && payload.data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Set the adminEmail/adminPassword collection variables to ADMIN_EMAIL/ADMIN_PASSWORD from your local .env.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "const payload = pm.response.json();",
                  "pm.test(\"Response contains data.access_token\", function () { pm.expect(payload.data && payload.data.access_token).to.be.ok; });",
                  "pm.collectionVariables.set(\"adminToken\", payload.data && payload.data.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
