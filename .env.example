# Copy this file to .env for local development. Replace JWT_SECRET before running.
APP_ENV=development
PORT=8080
DB_PATH=./data/ecommerce.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_TTL=15m

# Optional: set both to create a local development admin on startup.
# Never reuse development credentials in production.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-long-local-password
